# Unity3D generated meta files (KHÔNG ignore .meta trong Assets!)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/

# Crashlytics generated file
crashlytics-build.properties

# Packages (nếu dùng Package Manager, giữ lại manifest.json và packages-lock.json)
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json
